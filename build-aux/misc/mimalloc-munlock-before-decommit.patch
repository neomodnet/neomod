diff --git a/src/prim/unix/prim.c b/src/prim/unix/prim.c
--- a/src/prim/unix/prim.c
+++ b/src/prim/unix/prim.c
@@ -602,7 +602,13 @@ static int unix_madvise_release(void* start, size_t size) {
   return err;
   #else
   // use MADV_DONTNEED as it decreases rss immediately (unlike MADV_FREE)
-  return unix_madvise(start, size, MADV_DONTNEED);
+  int err = unix_madvise(start, size, MADV_DONTNEED);
+  if (err == EINVAL) {
+    // pages may be locked (e.g. by mlockall from an audio subsystem); unlock and retry
+    munlock(start, size);
+    err = unix_madvise(start, size, MADV_DONTNEED);
+  }
+  return err;
   #endif
 }
 
